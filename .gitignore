# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Virtualenvs
.venv/
venv/
env/

# Local config / secrets
.env
.env.local
*.local.yml
*.local.yaml
secrets.yaml

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Logs
*.log
logs/

# Test artefacts
.pytest_cache/
test-results/
htmlcov/

# Local Postgres data (not committed, but kept out of git just in case)
*.dump
*.sql.gz

# Build output (if anyone adds a wheel later)
*.whl

# Demo screenshots / recordings
*.mp4
*.gif
screenshots/

# The /output and /tmp directories hold PDF renderings; keep
# their content out of git, but the dirs themselves may exist.
output/*
!output/.gitkeep
tmp/*
!tmp/.gitkeep
